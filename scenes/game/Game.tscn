offset_top = 10.0
offset_right = 492.0
offset_bottom = 38.0
horizontal_alignment = 1
text = "EXECUTIONER"

[node name="LostEssenceLabel" type="Label" parent="HUD"]
visible = false
offset_left = 654.0
offset_top = 10.0
offset_right = 834.0
offset_bottom = 38.0
horizontal_alignment = 2
text = ""

[node name="ComboLabel" type="Label" parent="HUD"]
visible = false
offset_left = 372.0
offset_top = 100.0
offset_right = 472.0
offset_bottom = 150.0
horizontal_alignment = 1
vertical_alignment = 1
theme_override_font_sizes/font_size = 28
