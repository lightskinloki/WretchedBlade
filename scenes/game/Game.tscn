; ══════════════════════════════════════════════
;  DEATH SCREEN
;  Hidden by default; shown when the blade shatters.
;  Hold to reconstitute = hold your thumb on screen for 1.5s.
; ══════════════════════════════════════════════
[node name="DeathScreen" type="CanvasLayer" parent="."]
visible = false
layer = 20
script = ExtResource("6_death")

; Semi-transparent black overlay — blocks touch to the game world
[node name="Background" type="ColorRect" parent="DeathScreen"]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.0, 0.0, 0.0, 0.62)
mouse_filter = 0

[node name="YouDiedLabel" type="Label" parent="DeathScreen"]
offset_left = 272.0
offset_top = 145.0
offset_right = 572.0
offset_bottom = 210.0
horizontal_alignment = 1
theme_override_font_sizes/font_size = 42
text = "YOU DIED"
modulate = Color(1, 1, 1, 0)

[node name="HoldPrompt" type="Label" parent="DeathScreen"]
offset_left = 252.0
offset_top = 220.0
offset_right = 592.0
offset_bottom = 252.0
horizontal_alignment = 1
text = "Hold to Reconstitute"
modulate = Color(1, 1, 1, 0)

[node name="HoldBar" type="ProgressBar" parent="DeathScreen"]
offset_left = 222.0
offset_top = 262.0
offset_right = 622.0
offset_bottom = 285.0
max_value = 100.0
value = 0.0
show_percentage = false

; Full-screen purple flash during reconstitution animation
[node name="FlashRect" type="ColorRect" parent="DeathScreen"]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.4, 0.0, 0.7, 0.0)
mouse_filter = 2

; ══════════════════════════════════════════════
;  TRANSITION SCREEN
;  Handles room transition fade + purple flash.
;  mouse_filter = 2 so touch passes through to game world.
; ══════════════════════════════════════════════
[node name="TransitionScreen" type="CanvasLayer" parent="."]
visible = true
layer = 25
script = ExtResource("7_transition")

; Solid black overlay for fades
[node name="BlackOverlay" type="ColorRect" parent="TransitionScreen"]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.0, 0.0, 0.0, 1.0)
mouse_filter = 2

; Purple flash pulse during transition
[node name="FlashRect" type="ColorRect" parent="TransitionScreen"]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.5, 0.0, 0.8, 1.0)
mouse_filter = 2

; Room number label displayed briefly during transition
[node name="RoomLabel" type="Label" parent="TransitionScreen"]
offset_left = 332.0
offset_top = 175.0
offset_right = 512.0
offset_bottom = 215.0
horizontal_alignment = 1
vertical_alignment = 1
theme_override_font_sizes/font_size = 32
text = ""
modulate = Color(1, 1, 1, 0)
mouse_filter = 2
